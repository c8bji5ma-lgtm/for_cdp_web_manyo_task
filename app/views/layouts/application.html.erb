<!DOCTYPE html>
<html>
  <head>
    <title>CdpWebManyoTask</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application',
                            media: 'all',
                            'data-turbolinks-track': 'reload' %>

    <%= stylesheet_pack_tag 'application',
                            media: 'all',
                            'data-turbolinks-track': 'reload' %>

    <%= javascript_pack_tag 'application',
                            'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <span class="navbar-brand">Task App</span>

      <% if logged_in? %>
        <div class="navbar-nav ml-auto">
          <% if current_user.admin? %>
            <%= link_to "ユーザ一覧",
                        admin_users_path,
                        id: "users-index",
                        class: "nav-item nav-link" %>

            <%= link_to "ユーザを登録する",
                        new_admin_user_path,
                        id: "add-user",
                        class: "nav-item nav-link" %>
          <% end %>

          <%= link_to t("navigation.tasks_index"),
                      tasks_path,
                      id: "tasks-index",
                      class: "nav-item nav-link" %>

          <%= link_to t("navigation.new_task"),
                      new_task_path,
                      id: "new-task",
                      class: "nav-item nav-link" %>

          <%= link_to "ラベル一覧",
                      labels_path,
                      id: "labels-index",
                      class: "nav-item nav-link" %>

          <%= link_to "ラベルを登録する",
                      new_label_path,
                      id: "new-label",
                      class: "nav-item nav-link" %>

          <%= link_to "アカウント設定",
                      user_path(current_user),
                      id: "account-setting",
                      class: "nav-item nav-link" %>

          <%= link_to "ログアウト",
                      session_path,
                      method: :delete,
                      id: "sign-out",
                      class: "nav-item nav-link" %>
        </div>
      <% else %>
        <div class="navbar-nav ml-auto">
          <%= link_to "アカウント登録",
                      new_user_path,
                      id: "sign-up",
                      class: "nav-item nav-link" %>

          <%= link_to "ログイン",
                      new_session_path,
                      id: "sign-in",
                      class: "nav-item nav-link" %>
        </div>
      <% end %>
    </nav>

    <% flash.each do |key, message| %>
      <% bootstrap_class =
           case key
           when "notice"
             "alert-success"
           when "alert"
             "alert-danger"
           else
             "alert-info"
           end %>

      <div class="alert <%= bootstrap_class %>" role="alert">
        <%= message %>
      </div>
    <% end %>

    <div class="container mt-4">
      <%= yield %>
    </div>
  </body>
</html>