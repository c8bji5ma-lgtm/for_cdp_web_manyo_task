<!DOCTYPE html>
<html>
  <head>
    <title>CdpWebManyoTask</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>

    <% flash.each do |key, message| %>
      <div>
        <%= message %>
      </div>
    <% end %>
    
      <nav>
        <%= link_to t("navigation.tasks_index"), tasks_path, id: "tasks-index" %>
        <%= link_to t("navigation.new_task"), new_task_path, id: "new-task" %>
      </nav>
    <%= yield %>
  </body>
</html>
