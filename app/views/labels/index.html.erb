<h1 class="mb-4">ラベル一覧ページ</h1>

<table class="table table-striped table-bordered">
  <thead class="thead-light">
    <tr>
      <th>名前</th>
      <th>タスク数</th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @labels.each do |label| %>
      <tr>
        <td><%= label.name %></td>
        <td><%= label.tasks.count %></td>

        <td>
          <%= link_to "編集",
                      edit_label_path(label),
                      class: "edit-label btn btn-warning btn-sm" %>
        </td>

        <td>
          <%= link_to "削除",
                      label_path(label),
                      method: :delete,
                      data: { confirm: "本当に削除してもよろしいですか？" },
                      class: "destroy-label btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>