<h1 class="mb-4"><%= t("tasks.index.title") %></h1>

<%= form_with url: tasks_path,
              scope: :search,
              method: :get,
              local: true do |form| %>

  <div class="form-row align-items-end mb-4">
    <div class="form-group col-md-4">
      <%= form.label :title, "タイトル" %>
      <%= form.text_field :title,
                          value: params.dig(:search, :title),
                          class: "form-control" %>
    </div>

    <div class="form-group col-md-3">
      <%= form.label :status, "ステータス" %>
      <%= form.select :status,
                      Task.statuses.keys,
                      {
                        include_blank: true,
                        selected: params.dig(:search, :status)
                      },
                      class: "form-control" %>
    </div>

    <div class="form-group col-md-3">
      <%= form.label :label, "ラベル" %>
      <%= form.select :label,
                      current_user.labels.map { |label| [label.name, label.id] },
                      {
                        include_blank: true,
                        selected: params.dig(:search, :label)
                      },
                      class: "form-control" %>
    </div>

    <div class="form-group col-md-2">
      <%= form.submit "検索",
                      id: "search_task",
                      class: "btn btn-primary btn-block" %>
    </div>
  </div>
<% end %>

<%= paginate @tasks %>

<table class="table table-striped table-bordered">
  <thead class="thead-light">
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:content) %></th>

      <th>
        <%= link_to "終了期限",
                    { sort_deadline_on: true },
                    data: { turbo: false, turbolinks: false } %>
      </th>

      <th>
        <%= link_to "優先度",
                    { sort_priority: true },
                    data: { turbo: false, turbolinks: false } %>
      </th>

      <th>ステータス</th>
      <th><%= Task.human_attribute_name(:created_at) %></th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.deadline_on %></td>
        <td><%= task.priority %></td>
        <td><%= task.status %></td>
        <td><%= task.created_at %></td>

        <td>
          <%= link_to t("tasks.index.show"),
                      task_path(task),
                      class: "show-task btn btn-info btn-sm" %>
        </td>

        <td>
          <%= link_to t("tasks.index.edit"),
                      edit_task_path(task),
                      class: "edit-task btn btn-warning btn-sm" %>
        </td>

        <td>
          <%= link_to t("tasks.index.destroy"),
                      task_path(task),
                      method: :delete,
                      data: { confirm: t("tasks.index.confirm_destroy") },
                      class: "destroy-task btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @tasks %>