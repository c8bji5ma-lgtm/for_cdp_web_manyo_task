<h1><%= t("tasks.index.title") %></h1>

<%= form_with url: tasks_path, scope: :search, method: :get, local: true do |form| %>
  <div>
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title, value: params.dig(:search, :title) %>
  </div>

  <div>
    <%= form.label :status, "ステータス" %>
    <%= form.select :status,
                    Task.statuses.keys,
                    { include_blank: true, selected: params.dig(:search, :status) } %>
  </div>

  <div>
    <%= form.submit "検索", id: "search_task" %>
  </div>
<% end %>

<%= paginate @tasks %>

<table>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:content) %></th>

      <th>
        <%= link_to "終了期限",
                    { sort_deadline_on: true },
                    data: { turbo: false, turbolinks: false } %>
      </th>

      <th>
        <%= link_to "優先度",
                    { sort_priority: true },
                    data: { turbo: false, turbolinks: false } %>
      </th>

      <th>ステータス</th>
      <th><%= Task.human_attribute_name(:created_at) %></th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.deadline_on %></td>
        <td><%= task.priority %></td>
        <td><%= task.status %></td>
        <td><%= task.created_at %></td>

        <td>
          <%= link_to t("tasks.index.show"),
                      task_path(task),
                      class: "show-task" %>
        </td>

        <td>
          <%= link_to t("tasks.index.edit"),
                      edit_task_path(task),
                      class: "edit-task" %>
        </td>

        <td>
          <%= link_to t("tasks.index.destroy"),
                      task_path(task),
                      method: :delete,
                      data: { confirm: t("tasks.index.confirm_destroy") },
                      class: "destroy-task" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @tasks %>