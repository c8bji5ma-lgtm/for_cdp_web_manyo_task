<h1><%= t("tasks.edit.title") %></h1>

<% if @task.errors.any? %>
  <ul>
    <% @task.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with(model: @task, local: true) do |form| %>
  <div>
    <%= form.label :title, Task.human_attribute_name(:title) %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, Task.human_attribute_name(:content) %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.submit t("tasks.edit.submit"), id: "update-task" %>
  </div>
<% end %>

<%= link_to t("tasks.edit.back"), task_path(@task), id: "back" %>