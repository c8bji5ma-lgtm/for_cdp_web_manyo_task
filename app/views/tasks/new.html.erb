<h1><%= t("tasks.new.title") %></h1>

<% if @task.errors.any? %>
  <ul>
    <% @task.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @task do |form| %>
  <div>
    <%= form.label :title, Task.human_attribute_name(:title) %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, Task.human_attribute_name(:content) %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.submit t("tasks.new.submit"), id: "create-task" %>
  </div>
<% end %>

<%= link_to t("tasks.new.back"), tasks_path, id: "back" %>