<h1 class="mb-4"><%= t("tasks.show.title") %></h1>

<div class="card">
  <div class="card-body">
    <p>
      <strong><%= Task.human_attribute_name(:title) %>:</strong>
      <%= @task.title %>
    </p>

    <p>
      <strong><%= Task.human_attribute_name(:content) %>:</strong>
      <%= @task.content %>
    </p>

    <p>
      <strong>終了期限:</strong>
      <%= @task.deadline_on %>
    </p>

    <p>
      <strong>優先度:</strong>
      <%= @task.priority %>
    </p>

    <p>
      <strong>ステータス:</strong>
      <%= @task.status %>
    </p>

    <p>
      <strong>ラベル:</strong>
      <%= @task.labels.map(&:name).join(", ") %>
    </p>

    <p>
      <strong><%= Task.human_attribute_name(:created_at) %>:</strong>
      <%= @task.created_at %>
    </p>
  </div>
</div>

<div class="mt-3">
  <%= link_to t("tasks.show.edit"),
              edit_task_path(@task),
              id: "edit-task",
              class: "btn btn-warning" %>

  <%= link_to t("tasks.show.back"),
              tasks_path,
              id: "back",
              class: "btn btn-secondary" %>
</div>